+func (g *URLTestGroup) LoadManualSelected(groupTag string) {
+	if groupTag == "" {
+		return
+	}
+	cacheFile := service.FromContext[adapter.CacheFile](g.ctx)
+	if cacheFile == nil {
+		return
+	}
+	selected := cacheFile.LoadSelected(groupTag)
+	if selected == "" {
+		return
+	}
+	for _, detour := range g.outbounds {
+		if detour.Tag() == selected {
+			g.manualSelected = detour
+			g.selectedOutboundTCP = detour
+			g.selectedOutboundUDP = detour
+			return
+		}
+	}
+}
+
+func (g *URLTestGroup) SelectOutbound(groupTag string, tag string) bool {
+	var selected adapter.Outbound
+	for _, detour := range g.outbounds {
+		if detour.Tag() == tag {
+			selected = detour
+			break
+		}
+	}
+	if selected == nil {
+		return false
+	}
+	if g.manualSelected == selected && g.selectedOutboundTCP == selected && g.selectedOutboundUDP == selected {
+		return true
+	}
+	g.manualSelected = selected
+	g.selectedOutboundTCP = selected
+	g.selectedOutboundUDP = selected
+	if groupTag != "" {
+		cacheFile := service.FromContext[adapter.CacheFile](g.ctx)
+		if cacheFile != nil {
+			if err := cacheFile.StoreSelected(groupTag, tag); err != nil {
+				g.logger.Error("store selected: ", err)
+			}
+		}
+	}
+	g.interruptGroup.Interrupt(g.interruptExternalConnections)
+	return true
+}
