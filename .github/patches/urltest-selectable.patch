+func (g *URLTestGroup) SelectOutbound(tag string) bool {
+	g.access.Lock()
+	defer g.access.Unlock()
+	var selected adapter.Outbound
+	for _, detour := range g.outbounds {
+		if detour.Tag() == tag || RealTag(detour) == tag {
+			selected = detour
+			break
+		}
+	}
+	if selected == nil {
+		return false
+	}
+	if !common.Contains(selected.Network(), N.NetworkTCP) && !common.Contains(selected.Network(), N.NetworkUDP) {
+		return false
+	}
+	updated := false
+	if common.Contains(selected.Network(), N.NetworkTCP) && g.selectedOutboundTCP != selected {
+		g.selectedOutboundTCP = selected
+		updated = true
+	}
+	if common.Contains(selected.Network(), N.NetworkUDP) && g.selectedOutboundUDP != selected {
+		g.selectedOutboundUDP = selected
+		updated = true
+	}
+	if updated {
+		selectedTag := selected.Tag()
+		if selectedTag == "" {
+			selectedTag = tag
+		}
+		g.manualSelectedTag = selectedTag
+		if g.groupTag != "" {
+			if cacheFile := service.FromContext[adapter.CacheFile](g.ctx); cacheFile != nil {
+				if err := cacheFile.StoreSelected(g.groupTag, selectedTag); err != nil {
+					g.logger.Error("store selected: ", err)
+				}
+			}
+		}
+		g.interruptGroup.Interrupt(g.interruptExternalConnections)
+		if g.history != nil {
+			g.history.NotifyUpdated()
+		}
+	}
+	return true
+}
